{
  "version": 2,
  "builds": [
    {
      "src": "api/cors.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "LOGO COOSAJO SIN ESLOGAN.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/cors",
      "dest": "api/cors.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
